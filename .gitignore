# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Secrets & environment files ──────────────────────────────────────────────
# Keep .env.example (template) tracked; ignore every real env file.
.env
.env.*
!.env.example

# Backend local overrides / secret-bearing launchers
backend/src/main/resources/application-local.yml
backend/run-local.ps1
**/secrets/
**/credentials/
*credentials*.json
*service-account*.json
**/google-services.json
**/GoogleService-Info.plist
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# ─── Expo / React Native ──────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Generated native folders (prebuild)
/ios
/android

# ─── Native signing / tooling ─────────────────────────────────────────────────
.kotlin/
*.orig.*

# ─── Backend (Java / Maven / H2) ──────────────────────────────────────────────
backend/target/
backend/data/
backend/*.log
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ─── Logs & debug ─────────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*
lerna-debug.*

# ─── OS junk ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db

# ─── Editors / IDEs ───────────────────────────────────────────────────────────
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# Keep shared VS Code recommendations; ignore personal overrides
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# ─── TypeScript / test / coverage ─────────────────────────────────────────────
*.tsbuildinfo
coverage/
.nyc_output/
*.lcov

# ─── Tooling / agent worktrees ────────────────────────────────────────────────
.aider*
.claude/
.cursor/
.grok/

# ─── Misc local / temp ────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.cache
.cache/
tmp/
temp/
)
