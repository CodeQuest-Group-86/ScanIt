# ─── ScanIt Mobile — Environment Variables Template ───────────────────────────
# Copy this file to .env.local and fill in real values.
# EXPO_PUBLIC_* vars are inlined at build time and visible to the client bundle.
# Never put secrets in EXPO_PUBLIC_* vars.

# ─── Backend secrets (server-side only — set on Render, never in client) ──────
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=ScanIt <onboarding@resend.dev>
JWT_SECRET=your_jwt_secret_here

# ─── Termii — SMS OTP ─────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=ScanIt
TERMII_CHANNEL=generic

# ─── Gemini Vision — Mobile on-device fallback ────────────────────────────────
# Get a free key: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Local dev (same machine):     http://localhost:8080/api/v1
# Android emulator → host:      http://10.0.2.2:8080/api/v1
# Physical device on LAN:       http://YOUR_LAN_IP:8080/api/v1
# Production:                   https://scanit-backend.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# ─── App metadata ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=ScanIt
EXPO_PUBLIC_APP_ENV=development

# ─── Paystack (payments) ──────────────────────────────────────────────────────
# Public key only — safe to expose in client bundle
# Get keys: https://dashboard.paystack.com/#/settings/developer
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_key_here

# Paystack subscription plan codes (create at https://dashboard.paystack.com/#/plans)
EXPO_PUBLIC_PAYSTACK_PLAN_MONTHLY=
EXPO_PUBLIC_PAYSTACK_PLAN_YEARLY=

# ─── Hugging Face Inference API (free — AI models) ────────────────────────────
# Get token: https://huggingface.co/settings/tokens → New token → Read
EXPO_PUBLIC_HF_TOKEN=your_hf_token_here

# ─── Optional: self-hosted model servers ──────────────────────────────────────
# Leave blank to use HuggingFace Inference API (free).
EXPO_PUBLIC_CLIP_API_URL=
EXPO_PUBLIC_RESNET_API_URL=
EXPO_PUBLIC_BERT_API_URL=

# ─── Google Sign-In (free) ─────────────────────────────────────────────────────
# Create an OAuth consent screen + 3 OAuth Client IDs at
# https://console.cloud.google.com/apis/credentials — the "Continue with Google"
# button on the sign-in screen stays hidden until at least one of these is set.
# The same three values (without EXPO_PUBLIC_) must also be set as
# GOOGLE_OAUTH_WEB_CLIENT_ID / _IOS_CLIENT_ID / _ANDROID_CLIENT_ID on the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
