# ─── ScanIt Mobile — Environment Variables Template ───────────────────────────
# Copy this file to .env.local and fill in real values.
# EXPO_PUBLIC_* vars are inlined at build time and visible to the client bundle.
# Never put secrets in EXPO_PUBLIC_* vars.
#
# alternate_2 branch stack (all free tier):
#   Auth/OTP            → Resend           https://resend.com
#   Product ID          → Google Gemini    https://aistudio.google.com/app/apikey
#   Price comparison    → SerpAPI          https://serpapi.com
#   Media storage       → Cloudinary       https://cloudinary.com
#   Backend hosting     → Render           https://render.com

# ─── Backend secrets (server-side only — set on Render, never in client) ──────

# Resend — all app email: OTP codes + password-reset links (free tier: 3,000/mo, 100/day)
# Sign up at https://resend.com → API Keys → Create key
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=ScanIt <onboarding@resend.dev>

# Gemini Vision — product identification (free tier: 1,500 requests/day)
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI — live price comparison / where-to-buy links (free tier: 100 searches/month)
# Sign up at https://serpapi.com → copy your private API key
SERPAPI_API_KEY=your_serpapi_key_here

# Cloudinary — scan photo storage (free tier: 25 monthly credits)
# Sign up at https://cloudinary.com → Dashboard for these three values
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

JWT_SECRET=your_jwt_secret_here

# ─── Gemini Vision — Mobile on-device fallback (offline mode) ─────────────────
# Get a free key: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Local dev (same machine):     http://localhost:8080/api/v1
# Android emulator → host:      http://10.0.2.2:8080/api/v1
# Physical device on LAN:       http://YOUR_LAN_IP:8080/api/v1
# Production (Render):          https://scanit-backend.onrender.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1

# ─── App metadata ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_NAME=ScanIt
EXPO_PUBLIC_APP_ENV=development

# ─── Paystack (payments) ──────────────────────────────────────────────────────
# Public key only — safe to expose in client bundle. The SECRET key goes in the
# BACKEND's env vars as PAYSTACK_SECRET_KEY and must never appear here.
# Get keys: https://dashboard.paystack.com/#/settings/developer
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Paystack subscription plan codes (create at https://dashboard.paystack.com/#/plans)
EXPO_PUBLIC_PAYSTACK_PLAN_MONTHLY=
EXPO_PUBLIC_PAYSTACK_PLAN_YEARLY=

# ─── Hugging Face Inference API (free — on-device AI model fallback) ──────────
# Get token: https://huggingface.co/settings/tokens → New token → Read
EXPO_PUBLIC_HF_TOKEN=your_hf_token_here

# ─── Optional: self-hosted model servers ──────────────────────────────────────
# Leave blank to use HuggingFace Inference API (free).
EXPO_PUBLIC_CLIP_API_URL=
EXPO_PUBLIC_RESNET_API_URL=
EXPO_PUBLIC_BERT_API_URL=
