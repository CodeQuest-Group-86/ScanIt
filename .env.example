# API Configuration
# For local development with Android emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
# For physical device on same WiFi (replace with your computer's IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.XXX:8080/api/v1
# For production backend:
# EXPO_PUBLIC_API_URL=https://your-backend-url.com/api/v1

# Gemini AI API Key (for product scanning)
# Get free key at: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=AQ.Ab8RN6KLWu9ZHZhjQD-E-iT5hMfuUxSE01m49U1fDoFm9qF3vg

# HuggingFace API Token (optional, for alternative AI models)
# Get free token at: https://huggingface.co/settings/tokens
EXPO_PUBLIC_HF_TOKEN=your_hf_token_here

# Paystack Configuration (for payments)
# Get keys at: https://dashboard.paystack.co/#/settings/keys
# PUBLIC key only — safe to ship in the app. The SECRET key goes in the
# BACKEND's env vars as PAYSTACK_SECRET_KEY and must never appear here or in
# any EXPO_PUBLIC_ variable, since those get bundled into the APK.
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
